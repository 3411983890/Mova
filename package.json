{
  "name": "mova-ui-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "productName": "Mova",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:edge": "node scripts/build-edge.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "test": "node --test",
    "accept": "node scripts/accept.mjs",
    "accept:fast": "node scripts/accept.mjs --fast",
    "logs": "node scripts/collect-logs.mjs",
    "desktop": "node scripts/prepare-electron.mjs && npm run build && electron .",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:desktop:zip": "node scripts/package-desktop.mjs --zip",
    "desktop:smoke": "node scripts/desktop-smoke.cjs",
    "services": "node scripts/services.mjs ensure",
    "services:status": "node scripts/services.mjs status",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/web": "2.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.3",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "sharp": "0.34.5",
    "typescript": "6.0.3",
    "vite": "6.4.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@huggingface/transformers": "^4.3.2",
    "@keyline-icons/react": "^2.6.0",
    "@open-pencil/core": "0.16.0",
    "@open-pencil/vue": "0.16.0",
    "@radix-ui/react-slider": "^1.4.7",
    "@shikijs/langs": "^4.6.0",
    "bullmq": "^6.7.3",
    "clsx": "^2.1.1",
    "deep-agent-base-ui": "npm:@base-ui/react@^1.8.0",
    "deep-agent-lucide": "npm:lucide-react@^1.43.0",
    "generative-loaders": "^0.1.1",
    "gsap": "^3.12.7",
    "ioredis": "^6.0.0",
    "koffi": "^3.3.7",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "vue": "3.5.41",
    "yaml": "2.9.1"
  }
}
