# Mova 本地服务配置示例（复制为 .env 后使用；.env 不要提交）
# 这些值只用于本机开发，不是真实密钥。生产环境请使用系统凭据/密钥管理服务。
#
# docker compose 与 scripts/services.mjs 都会读取本文件所在目录的 .env。
# 修改数据库用户/密码/端口时，MOVA_DB_URL 与下方的 MOVA_DB_* 必须保持一致。

MOVA_MODE=postgres

# PostgreSQL（pgvector/pgvector:pg16，宿主机 127.0.0.1:55432）
MOVA_DB_URL=postgres://mova:mova_local_password@127.0.0.1:55432/mova
MOVA_DB_NAME=mova
MOVA_DB_USER=mova
MOVA_DB_PASSWORD=mova_local_password
MOVA_DB_PORT=55432

# Redis / BullMQ（redis:7-alpine，仅回环地址，无密码）
MOVA_REDIS_URL=redis://127.0.0.1:56379
MOVA_REDIS_PORT=56379

# MinIO（S3 兼容对象存储；59090 为 API，59091 为控制台）
# 说明：Windows 可能把 58986-59085 保留给 Hyper-V/WinNAT，导致 59000/59001
# 无法监听；这里使用范围外的 59090/59091。若本机 59000 可用，可改回并与
# MOVA_S3_ENDPOINT 保持一致。
MOVA_S3_ENDPOINT=http://127.0.0.1:59090
MOVA_S3_REGION=us-east-1
MOVA_S3_BUCKET=mova-artifacts
MOVA_S3_ACCESS_KEY=mova
MOVA_S3_SECRET_KEY=mova_local_password
MOVA_MINIO_PORT=59090
MOVA_MINIO_CONSOLE_PORT=59091
# 官方 minio/minio 镜像在当前环境不可拉取，默认使用 Bitnami legacy 构建；
# 若官方镜像恢复可用，改回 minio/minio:latest 即可。
MOVA_MINIO_IMAGE=bitnamilegacy/minio:latest

# 服务启动策略：true 表示 Docker 守护进程未运行时自动启动 Docker Desktop（Windows）
MOVA_AUTOSTART_SERVICES=true
# 可选：覆盖 compose 项目名 / 文件位置 / Docker CLI / Docker Desktop 可执行文件
MOVA_COMPOSE_PROJECT=mova-local
MOVA_COMPOSE_FILE=docker-compose.yml
MOVA_DOCKER_CLI=
MOVA_DOCKER_DESKTOP_PATH=
# 启动 Docker Desktop 的最长等待（毫秒）
MOVA_DOCKER_START_TIMEOUT_MS=180000
# 等待容器健康的最长时间（毫秒）与轮询间隔
MOVA_SERVICE_HEALTH_TIMEOUT_MS=120000
MOVA_SERVICE_POLL_MS=2000

# 本地 Embedding（ONNX；384 维）
MOVA_EMBEDDING_MODEL=Xenova/multilingual-e5-small
MOVA_EMBEDDING_DIM=384
MOVA_EMBEDDING_CACHE_DIR=
MOVA_HF_ENDPOINT=

# 备份与 PITR
MOVA_BACKUP_DIR=
MOVA_BACKUP_RETENTION_DAYS=30
# WAL 归档与基础备份的宿主机根目录（compose 与 scripts/pitr.mjs 共用）
MOVA_BACKUPS_DIR=
MOVA_PITR_IMAGE=pgvector/pgvector:pg16
# PITR 使用的 Docker CLI（默认自动定位 Docker Desktop）
MOVA_DOCKER_CLI=
MOVA_DOCKER_BIN=
